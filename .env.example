# Sanity CMS Configuration
# Get these from https://www.sanity.io/manage after creating a project
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id_here"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# Optional: Sanity Read Token (if dataset is private)
# SANITY_API_READ_TOKEN=""

# Optional: Secret token for On-Demand Revalidation Webhook (/api/revalidate)
SANITY_REVALIDATE_SECRET="your_secret_token_here"
